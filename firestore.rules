rules_version = '2';

// KrishiSync Firestore rules. Role checks live HERE, not only in the UI.
// Roles: farmer | buyer | transporter | moderator | admin
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc(id) { return get(/databases/$(database)/documents/users/$(id)); }
    function me() { return userDoc(uid()).data; }
    function myRole() { return me().get('role', null); }
    function isActive() { return signedIn() && me().get('status', 'active') == 'active'; }
    function isAdmin() { return isActive() && myRole() == 'admin'; }
    function isMod() { return isActive() && (myRole() == 'moderator' || myRole() == 'admin'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      // Names, photos, district and ratings are shown to trade partners.
      allow read: if signedIn();

      // First login: create own doc with safe defaults, no role yet.
      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(
             ['phone', 'name', 'language', 'status', 'verification',
              'ratingAvg', 'ratingCount', 'createdAt', 'updatedAt'])
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.status == 'active'
        && request.resource.data.verification == 'none'
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0;

      // Owner edits own profile. Cannot touch status / ratings / phone.
      // Role: only once, only a self-selectable role.
      // Verification: may only move to 'pending' (submitting an NID).
      allow update: if isSelfUpdateOk(userId)
                    || isModVerificationUpdate()
                    || isAdmin();

      function isSelfUpdateOk(userId) {
        return signedIn() && userId == uid()
          && me().get('status', 'active') == 'active'
          && onlyChanges(['name', 'photoUrl', 'language', 'location', 'nidNumber',
                          'verification', 'role', 'savedAddresses', 'updatedAt'])
          && (!('role' in changed())
              || (resource.data.get('role', null) == null
                  && request.resource.data.role in ['farmer', 'buyer', 'transporter']))
          && (!('verification' in changed())
              || request.resource.data.verification == 'pending')
          && (!('name' in changed())
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 80));
      }

      function isModVerificationUpdate() {
        return isMod()
          && onlyChanges(['verification', 'verifiedBy', 'verifiedAt', 'updatedAt'])
          && request.resource.data.verification in ['verified', 'rejected', 'pending'];
      }

      allow delete: if isAdmin();
    }

    // ---------- listings/{id} ----------
    // Farmers create (always 'pending'); moderators approve/reject;
    // buyers & everyone signed in see only 'active' ones.
    match /listings/{id} {
      function isOwner() { return signedIn() && resource.data.farmerId == uid(); }
      function validListing(d) {
        return d.cropKey is string && d.cropNameBn is string && d.cropNameEn is string
          && d.cropNameBn.size() > 0 && d.cropNameBn.size() <= 40
          && d.grade in ['A', 'B', 'C']
          && d.quantityKg is number && d.quantityKg > 0 && d.quantityKg <= 1000000
          && d.availableKg is number && d.availableKg >= 0 && d.availableKg <= d.quantityKg
          && d.pricePerKg is number && d.pricePerKg > 0 && d.pricePerKg <= 100000
          && d.availableFrom is timestamp
          && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 3
          && d.pickup is map;
      }

      allow read: if signedIn()
        && (resource.data.status == 'active' || isOwner() || isMod());

      allow create: if isActive() && myRole() == 'farmer'
        && request.resource.data.farmerId == uid()
        && request.resource.data.status == 'pending'
        && validListing(request.resource.data);

      // Buyer placing an order: may only lower availableKg (sold at 0).
      function isBuyerStockDecrease() {
        return isActive() && myRole() == 'buyer'
          && resource.data.status == 'active'
          && onlyChanges(['availableKg', 'status', 'updatedAt'])
          && request.resource.data.availableKg is number
          && request.resource.data.availableKg >= 0
          && request.resource.data.availableKg < resource.data.availableKg
          && (request.resource.data.status == 'active'
              || (request.resource.data.status == 'sold'
                  && request.resource.data.availableKg == 0));
      }

      // Owner: may only mark an active listing as sold.
      allow update: if isBuyerStockDecrease() || (isOwner() && isActive()
          && onlyChanges(['status', 'updatedAt'])
          && resource.data.status == 'active'
          && request.resource.data.status == 'sold')
        // Moderator / admin: approve or reject with a note.
        || (isMod()
          && onlyChanges(['status', 'moderationNote', 'moderatedBy', 'moderatedAt', 'updatedAt'])
          && request.resource.data.status in ['active', 'hidden']
          && request.resource.data.moderatedBy == uid());

      allow delete: if isAdmin()
        || (isOwner() && resource.data.status in ['pending', 'hidden']);
    }

    // ---------- marketPrices/{cropKey} ----------
    match /marketPrices/{cropKey} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.price is number
        && request.resource.data.min is number
        && request.resource.data.max is number
        && request.resource.data.min <= request.resource.data.max;
    }

    // ---------- offers/{id} ----------
    // Buyer creates; farmer accepts / rejects / counters; buyer answers.
    match /offers/{id} {
      function isParty() {
        return signedIn() && (resource.data.buyerId == uid() || resource.data.farmerId == uid());
      }
      allow read: if isParty() || isMod();
      allow create: if isActive() && myRole() == 'buyer'
        && request.resource.data.buyerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.lastBy == 'buyer'
        && request.resource.data.pricePerKg is number && request.resource.data.pricePerKg > 0
        && request.resource.data.quantityKg is number && request.resource.data.quantityKg > 0
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'active'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.farmerId == request.resource.data.farmerId;
      allow update: if isParty() && isActive()
        && onlyChanges(['status', 'pricePerKg', 'buyerPrice', 'counterPrice', 'lastBy',
                        'updatedAt', 'expiresAt', 'orderId'])
        && request.resource.data.status in ['pending', 'countered', 'accepted', 'rejected', 'withdrawn']
        // Only the farmer may counter; the buyer's answer returns to pending.
        && (request.resource.data.status != 'countered' || resource.data.farmerId == uid())
        && (!('pricePerKg' in changed()) || request.resource.data.pricePerKg > 0);
    }

    // ---------- counters/orders ----------
    // Order numbers KS-1048, KS-1049 … (+1 per order, inside a transaction).
    match /counters/{name} {
      allow read: if signedIn();
      allow create: if isActive() && name == 'orders'
        && request.resource.data.keys().hasOnly(['next']);
      allow update: if isActive() && name == 'orders'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
    }

    // ---------- orders/{id} ----------
    match /orders/{id} {
      function isOrderParty() {
        return signedIn() && (resource.data.buyerId == uid() || resource.data.farmerId == uid()
          || resource.data.get('transporterId', null) == uid());
      }
      allow read: if isOrderParty() || isMod();
      allow create: if isActive() && myRole() == 'buyer'
        && request.resource.data.buyerId == uid()
        && request.resource.data.status == 'confirmed'
        && request.resource.data.quantityKg is number && request.resource.data.quantityKg > 0
        && request.resource.data.pricePerKg is number && request.resource.data.pricePerKg > 0
        && request.resource.data.transportMode in ['platform', 'self'];
      // Status moves are added with the transport flow (Part 6).
      allow update: if isAdmin();
    }

    // ---------- notifications/{uid}/items/{id} ----------
    match /notifications/{owner}/items/{id} {
      allow read: if signedIn() && owner == uid();
      // Anyone signed in may notify someone else, but must sign as themselves.
      allow create: if isActive()
        && request.resource.data.fromUid == uid()
        && request.resource.data.read == false
        && request.resource.data.type is string;
      allow update: if signedIn() && owner == uid() && onlyChanges(['read']);
      allow delete: if signedIn() && owner == uid();
    }

    // Everything else is closed until its Part adds rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
