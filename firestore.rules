rules_version = '2';

// KrishiSync Firestore rules. Role checks live HERE, not only in the UI.
// Roles: farmer | buyer | transporter | moderator | admin
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc(id) { return get(/databases/$(database)/documents/users/$(id)); }
    function me() { return userDoc(uid()).data; }
    function myRole() { return me().get('role', null); }
    function isActive() { return signedIn() && me().get('status', 'active') == 'active'; }
    function isAdmin() { return isActive() && myRole() == 'admin'; }
    function isMod() { return isActive() && (myRole() == 'moderator' || myRole() == 'admin'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      // Names, photos, district and ratings are shown to trade partners.
      allow read: if signedIn();

      // First login: create own doc with safe defaults, no role yet.
      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(
             ['phone', 'name', 'language', 'status', 'verification',
              'ratingAvg', 'ratingCount', 'createdAt', 'updatedAt'])
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.status == 'active'
        && request.resource.data.verification == 'none'
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0;

      // Owner edits own profile. Cannot touch status / ratings / phone.
      // Role: only once, only a self-selectable role.
      // Verification: may only move to 'pending' (submitting an NID).
      allow update: if isSelfUpdateOk(userId)
                    || isModVerificationUpdate()
                    || isRatingUpdate(userId)
                    || isAdmin();

      // A trade partner adds ONE rating, written in the same batch as a new
      // reviews/{id} doc from them to this user.
      function isRatingUpdate(userId) {
        let rid = request.resource.data.get('lastReviewId', '');
        let review = getAfter(/databases/$(database)/documents/reviews/$(rid)).data;
        return isActive() && userId != uid()
          && onlyChanges(['ratingAvg', 'ratingCount', 'lastReviewId'])
          && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
          && request.resource.data.ratingAvg >= 1 && request.resource.data.ratingAvg <= 5
          && !exists(/databases/$(database)/documents/reviews/$(rid))
          && review.toUid == userId && review.fromUid == uid();
      }

      function isSelfUpdateOk(userId) {
        return signedIn() && userId == uid()
          && me().get('status', 'active') == 'active'
          && onlyChanges(['name', 'photoUrl', 'language', 'location', 'nidNumber',
                          'verification', 'role', 'savedAddresses', 'vehicle',
                          'updatedAt'])
          && (!('role' in changed())
              || (resource.data.get('role', null) == null
                  && request.resource.data.role in ['farmer', 'buyer', 'transporter']))
          && (!('verification' in changed())
              || request.resource.data.verification == 'pending')
          && (!('name' in changed())
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 80));
      }

      function isModVerificationUpdate() {
        return isMod()
          && onlyChanges(['verification', 'verifiedBy', 'verifiedAt', 'updatedAt'])
          && request.resource.data.verification in ['verified', 'rejected', 'pending'];
      }

      allow delete: if isAdmin();
    }

    // ---------- listings/{id} ----------
    // Farmers create (always 'pending'); moderators approve/reject;
    // buyers & everyone signed in see only 'active' ones.
    match /listings/{id} {
      function isOwner() { return signedIn() && resource.data.farmerId == uid(); }
      function validListing(d) {
        return d.cropKey is string && d.cropNameBn is string && d.cropNameEn is string
          && d.cropNameBn.size() > 0 && d.cropNameBn.size() <= 40
          && d.grade in ['A', 'B', 'C']
          && d.quantityKg is number && d.quantityKg > 0 && d.quantityKg <= 1000000
          && d.availableKg is number && d.availableKg >= 0 && d.availableKg <= d.quantityKg
          && d.pricePerKg is number && d.pricePerKg > 0 && d.pricePerKg <= 100000
          && d.availableFrom is timestamp
          && d.photos is list && d.photos.size() >= 1 && d.photos.size() <= 3
          && d.pickup is map;
      }

      allow read: if signedIn()
        && (resource.data.status == 'active' || isOwner() || isMod());

      allow create: if isActive() && myRole() == 'farmer'
        && request.resource.data.farmerId == uid()
        && request.resource.data.status == 'pending'
        && validListing(request.resource.data);

      // Buyer placing an order: may only lower availableKg (sold at 0).
      function isBuyerStockDecrease() {
        return isActive() && myRole() == 'buyer'
          && resource.data.status == 'active'
          && onlyChanges(['availableKg', 'status', 'updatedAt'])
          && request.resource.data.availableKg is number
          && request.resource.data.availableKg >= 0
          && request.resource.data.availableKg < resource.data.availableKg
          && (request.resource.data.status == 'active'
              || (request.resource.data.status == 'sold'
                  && request.resource.data.availableKg == 0));
      }

      // Owner: may only mark an active listing as sold.
      allow update: if isBuyerStockDecrease() || (isOwner() && isActive()
          && onlyChanges(['status', 'updatedAt'])
          && resource.data.status == 'active'
          && request.resource.data.status == 'sold')
        // Moderator / admin: approve or reject with a note.
        || (isMod()
          && onlyChanges(['status', 'moderationNote', 'moderatedBy', 'moderatedAt', 'updatedAt'])
          && request.resource.data.status in ['active', 'hidden']
          && request.resource.data.moderatedBy == uid());

      allow delete: if isAdmin()
        || (isOwner() && resource.data.status in ['pending', 'hidden']);
    }

    // ---------- marketPrices/{cropKey} ----------
    match /marketPrices/{cropKey} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.price is number
        && request.resource.data.min is number
        && request.resource.data.max is number
        && request.resource.data.min <= request.resource.data.max;

      // Daily history for Price Trend (30), one doc per date (yyyy-MM-dd).
      match /history/{day} {
        allow read: if signedIn();
        allow write: if isAdmin()
          && request.resource.data.price is number
          && request.resource.data.min <= request.resource.data.max;
      }
    }

    // ---------- offers/{id} ----------
    // Buyer creates; farmer accepts / rejects / counters; buyer answers.
    match /offers/{id} {
      function isParty() {
        return signedIn() && (resource.data.buyerId == uid() || resource.data.farmerId == uid());
      }
      allow read: if isParty() || isMod();
      allow create: if isActive() && myRole() == 'buyer'
        && request.resource.data.buyerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.lastBy == 'buyer'
        && request.resource.data.pricePerKg is number && request.resource.data.pricePerKg > 0
        && request.resource.data.quantityKg is number && request.resource.data.quantityKg > 0
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'active'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.farmerId == request.resource.data.farmerId;
      allow update: if isParty() && isActive()
        && onlyChanges(['status', 'pricePerKg', 'buyerPrice', 'counterPrice', 'lastBy',
                        'updatedAt', 'expiresAt', 'orderId'])
        && request.resource.data.status in ['pending', 'countered', 'accepted', 'rejected', 'withdrawn']
        // Only the farmer may counter; the buyer's answer returns to pending.
        && (request.resource.data.status != 'countered' || resource.data.farmerId == uid())
        && (!('pricePerKg' in changed()) || request.resource.data.pricePerKg > 0);
    }

    // ---------- counters/orders ----------
    // Order numbers KS-1048, KS-1049 … (+1 per order, inside a transaction).
    match /counters/{name} {
      allow read: if signedIn();
      allow create: if isActive() && name == 'orders'
        && request.resource.data.keys().hasOnly(['next']);
      allow update: if isActive() && name == 'orders'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
    }

    // ---------- orders/{id} ----------
    match /orders/{id} {
      function isOrderParty() {
        return signedIn() && (resource.data.buyerId == uid() || resource.data.farmerId == uid()
          || resource.data.get('transporterId', null) == uid());
      }
      allow read: if isOrderParty() || isMod();
      allow create: if isActive() && myRole() == 'buyer'
        && request.resource.data.buyerId == uid()
        && request.resource.data.status == 'confirmed'
        && request.resource.data.quantityKg is number && request.resource.data.quantityKg > 0
        && request.resource.data.pricePerKg is number && request.resource.data.pricePerKg > 0
        && request.resource.data.transportMode in ['platform', 'self'];
      function delAfter() { return getAfter(/databases/$(database)/documents/deliveries/$(id)).data; }
      function to(s) { return request.resource.data.status == s; }
      function from(s) { return resource.data.status == s; }
      function statusOnly() { return onlyChanges(['status', 'timeline', 'updatedAt']); }
      function isSelf() { return resource.data.transportMode == 'self'; }

      allow update: if isAdmin() || (isActive() && (
        // Buyer books a transporter's bid (116).
        (resource.data.buyerId == uid() && from('confirmed') && to('transportBooked')
          && onlyChanges(['status', 'transporterId', 'transporterName', 'transportFare',
                          'total', 'timeline', 'updatedAt'])
          && delAfter().transporterId == request.resource.data.transporterId
          && delAfter().fare == request.resource.data.transportFare)
        // Transporter loads at the farm / delivers (delivery doc moves too).
        || (resource.data.get('transporterId', null) == uid() && statusOnly()
          && ((from('transportBooked') && to('pickedUp') && delAfter().status == 'pickedUp')
              || (from('pickedUp') && to('delivered') && delAfter().status == 'delivered')))
        // Self transport: farmer hands over, buyer receives.
        || (isSelf() && resource.data.farmerId == uid() && statusOnly()
          && from('confirmed') && to('pickedUp'))
        || (isSelf() && resource.data.buyerId == uid() && statusOnly()
          && from('pickedUp') && to('delivered'))
        // Buyer completes after rating (111).
        || (resource.data.buyerId == uid() && statusOnly()
          && from('delivered') && to('completed'))
      ));
    }

    // ---------- notifications/{uid}/items/{id} ----------
    match /notifications/{owner}/items/{id} {
      allow read: if signedIn() && owner == uid();
      // Anyone signed in may notify someone else, but must sign as themselves.
      allow create: if isActive()
        && request.resource.data.fromUid == uid()
        && request.resource.data.read == false
        && request.resource.data.type is string;
      allow update: if signedIn() && owner == uid() && onlyChanges(['read']);
      allow delete: if signedIn() && owner == uid();
    }

    // ---------- deliveries/{orderId} ("loads") ----------
    match /deliveries/{id} {
      function d() { return resource.data; }
      function nd() { return request.resource.data; }
      function isDelParty() {
        return signedIn() && (d().buyerId == uid() || d().farmerId == uid()
          || d().get('transporterId', null) == uid());
      }
      allow read: if isDelParty() || isMod()
        || (isActive() && myRole() == 'transporter' && d().status == 'open');

      // Created by the buyer in the order transaction.
      allow create: if isActive() && nd().buyerId == uid() && nd().status == 'open'
        && getAfter(/databases/$(database)/documents/orders/$(id)).data.buyerId == uid();

      allow update: if isActive() && (
        // Buyer books one of the bids.
        (d().buyerId == uid() && d().status == 'open' && nd().status == 'assigned'
          && onlyChanges(['status', 'transporterId', 'transporterName',
                          'transporterPhotoUrl', 'vehicle', 'fare', 'timeline', 'updatedAt'])
          && nd().fare == get(/databases/$(database)/documents/deliveries/$(id)/bids/$(nd().transporterId)).data.fare)
        // Assigned transporter: loaded at pickup.
        || (d().get('transporterId', null) == uid() && d().status == 'assigned'
          && nd().status == 'pickedUp' && onlyChanges(['status', 'timeline', 'updatedAt']))
        // Assigned transporter: delivered with the buyer's OTP.
        || (d().get('transporterId', null) == uid() && d().status == 'pickedUp'
          && nd().status == 'delivered'
          && onlyChanges(['status', 'otpInput', 'deliveredKg', 'proofPhotoUrl',
                          'timeline', 'updatedAt'])
          && nd().otpInput == get(/databases/$(database)/documents/deliveries/$(id)/private/otp).data.code)
        // Transporter rated the buyer.
        || (d().get('transporterId', null) == uid()
          && onlyChanges(['transporterRated', 'updatedAt']))
      );

      // 4-digit delivery code: only the buyer may read it.
      match /private/{doc} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/deliveries/$(id)).data.buyerId == uid();
        allow create: if isActive()
          && getAfter(/databases/$(database)/documents/deliveries/$(id)).data.buyerId == uid()
          && ((doc == 'otp' && request.resource.data.keys().hasOnly(['code']))
              || (doc == 'receipt'
                  && request.resource.data.keys().hasOnly(['photoUrl', 'createdAt'])));
      }

      // Transporter bids: one per transporter, while the load is open.
      match /bids/{tid} {
        function load() { return get(/databases/$(database)/documents/deliveries/$(id)).data; }
        allow read: if isActive() && (myRole() == 'transporter' || load().buyerId == uid());
        allow create, update: if isActive() && tid == uid() && myRole() == 'transporter'
          && load().status == 'open'
          && request.resource.data.status == 'pending'
          && request.resource.data.fare is number && request.resource.data.fare > 0
          && request.resource.data.keys().hasOnly(['name', 'photoUrl', 'vehicle',
               'ratingAvg', 'ratingCount', 'fare', 'status', 'createdAt']);
        // Buyer marks the booked bid as accepted.
        allow update: if isActive() && load().buyerId == uid()
          && onlyChanges(['status']) && request.resource.data.status == 'accepted';
      }
    }

    // ---------- reviews/{orderId_from_to} ----------
    match /reviews/{rid} {
      function ord() { return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data; }
      function inOrder(u) {
        return u == ord().buyerId || u == ord().farmerId || u == ord().get('transporterId', null);
      }
      allow read: if signedIn();
      allow create: if isActive()
        && request.resource.data.fromUid == uid()
        && rid == request.resource.data.orderId + '_' + uid() + '_' + request.resource.data.toUid
        && request.resource.data.toUid != uid()
        && inOrder(uid()) && inOrder(request.resource.data.toUid)
        && ord().status in ['delivered', 'completed']
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
    }

    // ---------- reports/{id} (Report Issue 203/204 → M4/M5) ----------
    match /reports/{id} {
      allow read: if isMod() || (signedIn() && resource.data.reporterId == uid());
      allow create: if isActive()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.escalated == false
        && request.resource.data.reason is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000;
      allow update: if isMod()
        && onlyChanges(['status', 'handledBy', 'modNote', 'escalated', 'updatedAt'])
        && request.resource.data.status in ['open', 'inReview', 'resolved', 'dismissed']
        && request.resource.data.handledBy == uid();
    }

    // ---------- crops/{key} (catalog, A6) ----------
    match /crops/{key} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Everything else is closed until its Part adds rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
